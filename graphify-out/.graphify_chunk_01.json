{
  "nodes": [
    {"id": "readme_web_app_cgtk_2027_frontend", "label": "Web App CGTK 2027 Frontend", "file_type": "document", "source_file": "C:\\Users\\Lenovo\\CGTK-Web-Frontend\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Rafly Pratama Hudzaifah Al Syahbani", "contributor": null, "rationale": "One React + TypeScript + Vite + Tailwind application serving every page, so the whole team ships into a single app rather than separate builds."},
    {"id": "readme_api_single_door", "label": "api.ts as the Only Door to the Backend", "file_type": "rationale", "source_file": "C:\\Users\\Lenovo\\CGTK-Web-Frontend\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reading tables directly from the browser via supabase.from() is always rejected with 401 because every table is locked by Row Level Security, and the failure explains nothing. All data must go through api.get."},
    {"id": "readme_supabase_login_only", "label": "Supabase Client Restricted to Google Login", "file_type": "rationale", "source_file": "C:\\Users\\Lenovo\\CGTK-Web-Frontend\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "src/lib/supabase.ts exists only for Google sign-in; Row Level Security means it can never be a data path."},
    {"id": "readme_envelope_unwrapping", "label": "api.get Unwraps the Response Envelope", "file_type": "concept", "source_file": "C:\\Users\\Lenovo\\CGTK-Web-Frontend\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "api.get already unwraps { sukses, data } so callers receive the payload directly and no page has to know the envelope shape."},
    {"id": "readme_verbatim_server_error_messages", "label": "Display Server Error Messages Verbatim (pesanDari)", "file_type": "rationale", "source_file": "C:\\Users\\Lenovo\\CGTK-Web-Frontend\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The server message is what tells the participant what to do. Replacing it with a generic sentence like 'Terjadi kesalahan' leaves them knowing only that it failed, and they then chat the committee one by one on the event day."},
    {"id": "readme_no_hardcoded_content", "label": "No Hardcoded Numbers or Copy in the Program", "file_type": "rationale", "source_file": "C:\\Users\\Lenovo\\CGTK-Web-Frontend\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ticket prices, XP values, schedules, FAQ text, form questions and sponsor data all come from the database so the committee can change them themselves. A Pull Request that violates this is rejected."},
    {"id": "readme_session_status_not_clock", "label": "LIVE Status From sesi.status, Not From Clock Time", "file_type": "rationale", "source_file": "C:\\Users\\Lenovo\\CGTK-Web-Frontend\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Event schedules always shift in the field and being twenty minutes late is normal. A LIVE badge computed from jam_mulai/jam_selesai would be wrong every time the schedule moves, sending participants to the wrong room."},
    {"id": "readme_use_muat_hook", "label": "useMuat Data-Loading Hook", "file_type": "concept", "source_file": "C:\\Users\\Lenovo\\CGTK-Web-Frontend\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shared loader in src/lib/kait.ts giving every page the same data/loading/error shape plus a muatUlang callback."},
    {"id": "readme_use_muat_ulang_berkala", "label": "useMuatUlangBerkala Visibility-Aware Polling", "file_type": "rationale", "source_file": "C:\\Users\\Lenovo\\CGTK-Web-Frontend\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Handles document.hidden so refreshing stops when the screen is not open. Hand-rolled setInterval is forbidden: if a participant's phone is in their pocket and the page keeps calling the API every minute, their battery and data quota are wasted."},
    {"id": "readme_env_fail_fast", "label": "Fail Fast on Missing VITE_SUPABASE_URL", "file_type": "rationale", "source_file": "C:\\Users\\Lenovo\\CGTK-Web-Frontend\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "npm run dev dies immediately when .env is missing or empty, on purpose, so the problem surfaces now rather than once a page is already half built."},
    {"id": "readme_halaman_info_reference_page", "label": "HalamanInfo.tsx as the Reference Page", "file_type": "concept", "source_file": "C:\\Users\\Lenovo\\CGTK-Web-Frontend\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A complete worked example from fetching data to handling failure; most pages have the same shape, so it is required reading before starting."},
    {"id": "readme_shared_api_types", "label": "Shared API Types (src/types/api.ts)", "file_type": "concept", "source_file": "C:\\Users\\Lenovo\\CGTK-Web-Frontend\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single declaration of the data shapes used across every page, so three developers' pages describe the same backend objects identically."},
    {"id": "readme_per_owner_page_folders", "label": "Per-Owner Page Folders (rijal, fariz, haqi)", "file_type": "concept", "source_file": "C:\\Users\\Lenovo\\CGTK-Web-Frontend\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "src/halaman is split by developer and App.tsx is the map of every route and its owner, so ownership is visible in the directory tree."},
    {"id": "readme_shared_state_components", "label": "Shared State Components (Memuat, PesanError, Kosong, Kerangka, WajibLogin)", "file_type": "concept", "source_file": "C:\\Users\\Lenovo\\CGTK-Web-Frontend\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One set of loading, error, empty, skeleton and login-required components so every page's failure and loading states look the same."},
    {"id": "readme_sesi_auth_context", "label": "sesi.tsx Current-User Session Context", "file_type": "concept", "source_file": "C:\\Users\\Lenovo\\CGTK-Web-Frontend\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single source of who is currently signed in, consumed by WajibLogin and by api for the bearer token."},
    {"id": "readme_git_pull_request_workflow", "label": "Branch and Pull Request Workflow", "file_type": "concept", "source_file": "C:\\Users\\Lenovo\\CGTK-Web-Frontend\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never push to main; branches are feat/<name>/<work>, every change goes through a Pull Request reviewed by Rafly, and npm run build must pass first."},
    {"id": "readme_one_pr_one_page", "label": "One Pull Request, One Page", "file_type": "rationale", "source_file": "C:\\Users\\Lenovo\\CGTK-Web-Frontend\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A PR containing four pages cannot be reviewed properly, and rejecting one page would mean holding back the other three."},
    {"id": "readme_one_team_one_library_choice", "label": "One Team, One Library Choice", "file_type": "rationale", "source_file": "C:\\Users\\Lenovo\\CGTK-Web-Frontend\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UI components, icons, date library and state manager are free choices, but must be the same across the team: if Fariz picks one and Haqi another, their pages will not fit together. The router is already fixed to react-router-dom."},
    {"id": "readme_build_before_pr_gate", "label": "npm run cek and npm run build Before a PR", "file_type": "concept", "source_file": "C:\\Users\\Lenovo\\CGTK-Web-Frontend\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "npm run cek typechecks without running anything and npm run build proves it really builds; both must pass before a Pull Request is opened."},
    {"id": "readme_anon_key_safe_in_browser", "label": "VITE_SUPABASE_ANON_KEY Safe in the Browser", "file_type": "rationale", "source_file": "C:\\Users\\Lenovo\\CGTK-Web-Frontend\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The anon key is meant to be public. service_role, the JWT secret and the database URL must never reach the frontend; needing one of them means the endpoint is missing, and the fix is a new endpoint, not a workaround. .env stays in .gitignore."},
    {"id": "readme_api_contract_doc", "label": "04-API-CONTRACT.md", "file_type": "document", "source_file": "C:\\Users\\Lenovo\\CGTK-Web-Frontend\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "readme_ketentuan_teknis_doc", "label": "06-KETENTUAN-TEKNIS.md (technical rules and task split)", "file_type": "document", "source_file": "C:\\Users\\Lenovo\\CGTK-Web-Frontend\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "readme_diagram_doc", "label": "02-DIAGRAM.md (page map and access rights, items 4 and 27)", "file_type": "document", "source_file": "C:\\Users\\Lenovo\\CGTK-Web-Frontend\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "readme_tugas_sheets", "label": "tugas/TUGAS-*.md Per-Person Task Sheets", "file_type": "document", "source_file": "C:\\Users\\Lenovo\\CGTK-Web-Frontend\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "readme_rafly_pratama_hudzaifah_al_syahbani", "label": "Rafly Pratama Hudzaifah Al Syahbani (reviewer and lead)", "file_type": "document", "source_file": "C:\\Users\\Lenovo\\CGTK-Web-Frontend\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "index_root_element", "label": "#root Mount Element", "file_type": "code", "source_file": "C:\\Users\\Lenovo\\CGTK-Web-Frontend\\index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The single empty div the whole SPA renders into; every page in src/halaman ultimately mounts here, which is what makes 'one application for all pages' true at the DOM level."},
    {"id": "index_main_module_entry", "label": "/src/main.tsx Module Entry Script", "file_type": "code", "source_file": "C:\\Users\\Lenovo\\CGTK-Web-Frontend\\index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vite's single module entry point; the environment-variable guard that aborts dev startup runs on this path before anything renders."},
    {"id": "index_lang_indonesian", "label": "Indonesian Document Language (lang=\"id\")", "file_type": "concept", "source_file": "C:\\Users\\Lenovo\\CGTK-Web-Frontend\\index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The whole UI and every server message are Indonesian, so the document language matches the text that is rendered verbatim."},
    {"id": "index_color_scheme_light_dark", "label": "color-scheme light dark Declaration", "file_type": "concept", "source_file": "C:\\Users\\Lenovo\\CGTK-Web-Frontend\\index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opts the page into both themes at the document level so a participant's phone in dark mode does not render unstyled white before Tailwind loads."},
    {"id": "index_mobile_viewport", "label": "Mobile Viewport Meta", "file_type": "concept", "source_file": "C:\\Users\\Lenovo\\CGTK-Web-Frontend\\index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "width=device-width, initial-scale=1.0: the audience holds phones, so the app is phone-first."}
